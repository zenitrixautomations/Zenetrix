{
  "ci": {
    "collect": {
      "startServerCommand": "npx serve out -l 3000",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/products/gate-automation/sliding-gate-automation/",
        "http://localhost:3000/hyderabad/banjara-hills/",
        "http://localhost:3000/videos/"
      ],
      "numberOfRuns": 2,
      "settings": {}
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 150
          }
        ]
      }
    }
  }
}