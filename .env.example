# Final canonical domain (https, one version only)
# Final domain (also set in .env.production). No trailing slash. Canonicals, sitemap and schema use it.
NEXT_PUBLIC_SITE_URL=https://zenitrixautomations.com
# Analytics (loads only after cookie consent)
# GA4 is hard-coded in app/layout.tsx <head> (G-5CL4FQ4XC7); no env var needed.
# Lead routing (any one is enough; with none, the form falls back to WhatsApp)
# RESEND_API_KEY=
# LEAD_TO_EMAIL=zenitrixautomations@gmail.com
# LEAD_FROM_EMAIL=Zenitrix Website <leads@yourdomain.com>
# LEAD_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# Cloudflare Turnstile spam protection
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Microsoft Clarity project id (loads only after cookie consent)
# NEXT_PUBLIC_CLARITY_ID=
# Staged publishing of service-by-area pages (Blueprint 10.3 / 14.3): 1 = first 100, 2 = 200, 3 = all 300 (a page also needs a real local project)
# NEXT_PUBLIC_RELEASE_BATCH=1
# Optional: send customers an automatic confirmation email when they enter an email address (needs RESEND_API_KEY)
# LEAD_CONFIRM_CUSTOMER=1

# --- Local SEO (fill these, nothing is invented if empty) ---
# Google Search Console HTML-tag verification: content value only
# NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster verification (msvalidate.01 content value)
# NEXT_PUBLIC_BING_VERIFICATION=
# Shop coordinates from Google Maps (right-click the pin)
# NEXT_PUBLIC_GEO_LAT=
# NEXT_PUBLIC_GEO_LNG=
# Google Maps / Business Profile share link
# NEXT_PUBLIC_MAPS_URL=
# Opening hours, schema.org format, separated by | (example: Mo-Sa 09:30-18:30)
# NEXT_PUBLIC_HOURS=
